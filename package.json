{
  "name": "safelight-flat-field-dark-frame",
  "private": true,
  "version": "1.0.0",
  "description": "Flat Field and Dark Frame extension for Safelight: dark frame subtraction and flat-field correction from calibration frames.",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/copy-libraw.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "update-types": "node scripts/update-types.mjs",
    "test:gpu": "node test/gpu/run.cjs",
    "copy-libraw": "node scripts/copy-libraw.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "keywords": [
    "safelight-extension"
  ],
  "dependencies": {
    "libraw-wasm": "1.4.0"
  },
  "license": "GPL-3.0-or-later"
}
